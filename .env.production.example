# Production environment template for self-hosted Docker Compose deploys.
# Copy to `.env.production` (git-ignored) and fill in real values:
#   cp .env.production.example .env.production
# Never commit real secrets — compose reads them from `.env.production`.
#
# Used by: docker-compose.production.yml
#   docker compose -f docker-compose.production.yml --env-file .env.production up -d --build

# --- PostgreSQL (managed preferred; these only apply to the compose db service) ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=portfolio

# --- Portfolio.Api ---
# Full Npgsql connection string for the production database.
# Managed Postgres example (Supabase/Neon/Render):
#   Host=db.example.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__PortfolioDb=Host=db;Port=5432;Database=portfolio;Username=portfolio;Password=CHANGE_ME_long_random_password;SSL Mode=Prefer

# Production frontend origin(s) for CORS. Must be exact https URLs, comma logic
# via indexed vars: Cors__AllowedOrigins__0, Cors__AllowedOrigins__1, ...
Cors__AllowedOrigins__0=https://www.example.com

# OpenAI key — host secret only, never in the repo.
# Leave empty to run the public site with the chatbot in "not configured" mode.
Ai__OpenAi__ApiKey=

# --- Admin CMS (JWT) ---
# The API refuses to start when Jwt__Key is missing/shorter than 32 chars.
# Generate one with: openssl rand -base64 48   (or any 32+ char random string)
Jwt__Key=CHANGE_ME_minimum_32_chars_random_string
Jwt__Issuer=portfolio-api
Jwt__Audience=portfolio-admin
Jwt__ExpiryMinutes=720

# Admin login identity (email is case-insensitive match).
Admin__Email=admin@example.com
# PBKDF2 hash of the admin password — NEVER the plaintext.
# Generate: dotnet run --project src/Portfolio.Api -- --hash-password 'your-password'
Admin__PasswordHash=

# First deploy: true/true creates schema + seed content. Later deploys: false/false
# (run `dotnet ef database update` from CI, content managed via Admin CMS later).
Database__MigrateOnStartup=true
Database__SeedOnStartup=true

# --- Frontend (Angular SSR) ---
# Baked into environment.prod.ts at image build time.
API_BASE_URL=https://api.example.com
# Port the SSR Node server listens on inside its container.
FRONTEND_PORT=4000
# Port published on the host for the frontend.
FRONTEND_HOST_PORT=4000
# Port published on the host for the API.
API_HOST_PORT=8080
