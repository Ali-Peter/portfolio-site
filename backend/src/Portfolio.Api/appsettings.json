{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 600,
      "WindowSeconds": 60
    },
    "Contact": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Ai": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Ai": {
    "TopK": 6,
    "MaxQuestionChars": 2000,
    "MaxContextChars": 9000,
    "OpenAi": {
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1",
      "ChatModel": "gpt-4o-mini",
      "EmbeddingModel": "text-embedding-3-small"
    }
  }
}

